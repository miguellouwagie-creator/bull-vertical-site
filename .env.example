# ============================================================
# BULL Vertical Services — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env or .env.local to Git.
# ============================================================

# Contact phone in E.164 format (e.g. +17861234567)
VITE_PHONE_E164=

# WhatsApp number for Spanish market, no '+' prefix (e.g. 34600000000)
VITE_WA_PHONE_ES=

# Public contact email
VITE_CONTACT_EMAIL=

# Cloudflare Turnstile — PUBLIC site key (safe to expose in client code)
# Get yours at: https://dash.cloudflare.com/ > Turnstile > Add site
# Use Cloudflare's test key (always passes) during local development:
#   1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
