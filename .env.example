# ============================================================
# BULL Vertical Services — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env or .env.local to Git.
# ============================================================

# Contact phone (E.164 format, USA line)
VITE_PHONE_E164=+17866130866

# WhatsApp number for Spanish market (no '+', for wa.me URL)
VITE_WA_PHONE_ES=34603428966

# Public contact email
VITE_CONTACT_EMAIL=bullverticalservice@gmail.com

# Cloudflare Turnstile — PUBLIC site key (safe to expose in client code)
# Get it at: https://dash.cloudflare.com/ > Turnstile > Add site
# Use the "Always passes" test key in development: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
