# =============================================================
# Cloudflare Pages — HTTP Security Headers
# Applied to every response served from this site.
# =============================================================

/*
  # Force HTTPS for 1 year; include subdomains; submit to preload list
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy
  # script-src 'self': only scripts bundled by Vite are allowed.
  # 'unsafe-inline' is NOT present — inline scripts are blocked.
  # NOTE: LD+JSON <script> tags are data blocks, not JS — not covered by script-src.
  # style-src 'unsafe-inline': required for Tailwind CSS inline styles (shadcn/ui).
  # connect-src: allows fetch/XHR to WhatsApp and Google Maps API.
  # navigate-to: allows window.open() to Gmail, WhatsApp, Google Maps and mailto.
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://wa.me https://api.whatsapp.com https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; navigate-to 'self' https://wa.me https://api.whatsapp.com https://www.google.com https://mail.google.com https://accounts.google.com mailto:; upgrade-insecure-requests

  # Never send Referer header to cross-origin destinations
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable access to sensitive browser APIs
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()

  # Prevent MIME-type sniffing attacks
  X-Content-Type-Options: nosniff

  # Prevent the site from being embedded in iframes (clickjacking)
  X-Frame-Options: DENY

  # Isolate browsing context (Spectre mitigation)
  Cross-Origin-Opener-Policy: same-origin

  # Prevent cross-origin resource reads
  Cross-Origin-Resource-Policy: same-origin

  # Block Flash/PDF cross-domain policy files
  X-Permitted-Cross-Domain-Policies: none

# =============================================================
# Cache-Control for immutable hashed assets (Vite build output)
# =============================================================

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/work/*
  Cache-Control: public, max-age=31536000, immutable

/hero/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=31536000, immutable
